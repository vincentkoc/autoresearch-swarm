{
  "name": "research-swarm-authority",
  "main": ".generated-production/entry.py",
  "base_dir": ".generated-production",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["python_workers"],
  "find_additional_modules": true,
  "rules": [{ "type": "ESModule", "globs": ["**/*.mjs"], "fallthrough": true }],
  "durable_objects": {
    "bindings": [
      { "name": "RESEARCH_AUTHORITY", "class_name": "ResearchAuthority" },
    ],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ResearchAuthority"] }],
  "r2_buckets": [
    { "binding": "ARTIFACTS", "bucket_name": "research-swarm-artifacts" },
  ],
  // Supply RESEARCH_MANIFEST from an operator-validated manifest and
  // RESEARCH_SECRETS through protected secret bindings. Neither has defaults.
  // No public route is enabled here. Bind the named Bootstrap entrypoint only
  // to an operator service; its credential is separate from research API tokens.
  // A recovery gateway may bind the named Recovery entrypoint and forward the
  // original worker request unchanged. Default remains the ordinary controller.
}
