{
  "name": "autoresearch-swarm-cloudflare",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "python3 build.py && esbuild crypto.js --bundle --format=esm --platform=browser --outfile=.generated/crypto.mjs && esbuild hybrid_contracts.ts hybrid_creation.ts agent_facade.ts --bundle --format=esm --platform=browser --outdir=.generated --out-extension:.js=.mjs",
    "build:production": "python3 build.py --target production && esbuild crypto.js --bundle --format=esm --platform=browser --outfile=.generated-production/crypto.mjs",
    "test:crypto": "node --test crypto.test.mjs",
    "check:hybrid": "tsc --noEmit && prettier --check \"hybrid*.ts\" \"hybrid*.mjs\" \"agent_facade.*\" r2_fixture.ts tsconfig.json \"wrangler.*.jsonc\"",
    "test:hybrid": "node --test hybrid_contracts.test.mjs agent_facade.test.mjs && node --experimental-strip-types --test hybrid_transport.test.mjs"
  },
  "dependencies": {
    "@noble/curves": "2.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261030.1",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "wrangler": "4.156.0"
  }
}
